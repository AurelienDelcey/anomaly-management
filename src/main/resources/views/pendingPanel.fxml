<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0" spacing="5.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="userInterface.PendingPanelController">
   <children>
      <HBox prefHeight="100.0" prefWidth="200.0">
         <children>
            <VBox>
               <children>
                  <Label text="Sector:" />
                  <ComboBox fx:id="sectorCombo" onAction="#onSelectSector" prefWidth="150.0" />
               </children>
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
            <VBox>
               <children>
                  <Label text="Production order:" />
                  <TextField fx:id="productionOrderTextField" onAction="#onClickCorrectProductionOrder" />
                  <Button fx:id="correctProductionOrderButton" mnemonicParsing="false" onAction="#onClickCorrectProductionOrder" text="Correct" />
               </children>
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
            <VBox>
               <children>
                  <Label text="Machine:" />
                  <ComboBox fx:id="machineCombo" onAction="#onSelectMachine" prefWidth="150.0" />
               </children>
            </VBox>
         </children>
      </HBox>
      <HBox prefHeight="100.0" prefWidth="200.0" spacing="5.0">
         <children>
            <VBox>
               <children>
                  <Label text="Impacted quantity:" />
                  <TextField fx:id="impactedQuantityTextField" onAction="#onClickCorrectQuantity" />
                  <Button fx:id="correctImpactedQuantity" mnemonicParsing="false" onAction="#onClickCorrectQuantity" text="Correct" />
               </children>
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
            <VBox>
               <children>
                  <Label text="Corrective action id:" />
                  <TextField fx:id="correctiveActionTextField" onAction="#onClickValidationCorrectiveAction" promptText="ABC-000-DDMMYY" />
                  <Button fx:id="validationCorrectiveActionButton" mnemonicParsing="false" onAction="#onClickValidationCorrectiveAction" text="Validation" />
               </children>
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
            <Label text="Quality decision:" />
            <VBox spacing="5.0">
               <children>
                  <RadioButton fx:id="repairButton" mnemonicParsing="false" onAction="#onClickRepair" text="Repair">
                     <toggleGroup>
                        <ToggleGroup fx:id="qualityDecisionGroup" />
                     </toggleGroup>
                  </RadioButton>
                  <RadioButton fx:id="scrapButton" mnemonicParsing="false" onAction="#onClickScrap" text="Scrap" toggleGroup="$qualityDecisionGroup" />
                  <RadioButton fx:id="naButton" mnemonicParsing="false" onAction="#onClickNa" text="N/A" toggleGroup="$qualityDecisionGroup" />
               </children>
            </VBox>
         </children>
      </HBox>
      <Label text="Descrition:" />
      <TextArea fx:id="descriptionTextArea" prefHeight="200.0" prefWidth="200.0" />
      <HBox>
         <children>
            <Button fx:id="correctedDescriptionButton" mnemonicParsing="false" onAction="#onClickCorrectedDescritpion" text="Correct description" />
         </children>
      </HBox>
      <HBox>
         <children>
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="correctAnomalyButton" mnemonicParsing="false" onAction="#onClickCorrectAnomaly" text="Correct anomaly" />
            <Region HBox.hgrow="ALWAYS" />
         </children>
      </HBox>
   </children>
   <padding>
      <Insets bottom="5.0" left="30.0" right="30.0" top="5.0" />
   </padding>
</VBox>
