<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="5.0" xmlns="http://javafx.com/javafx/21.0.2" xmlns:fx="http://javafx.com/fxml/1" fx:controller="userInterface.detail.HistoryViewController">
   <children>
      <ListView fx:id="anomalyListView" />
      <Button fx:id="openButton" mnemonicParsing="false" onAction="#onClickOpen" text="Open" />
   </children>
   <padding>
      <Insets bottom="5.0" />
   </padding>
</VBox>
