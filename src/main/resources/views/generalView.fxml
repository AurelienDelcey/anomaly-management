<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="700.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="userInterface.GeneralViewController">
   <children>
      <HBox alignment="BOTTOM_LEFT" prefHeight="38.0" prefWidth="953.0" spacing="10.0">
         <children>
            <VBox alignment="CENTER_LEFT" prefHeight="73.0" prefWidth="115.0">
               <children>
                  <Label prefHeight="18.0" prefWidth="60.0" text="Sort by:">
                     <VBox.margin>
                        <Insets left="10.0" />
                     </VBox.margin></Label>
                  <ComboBox fx:id="sortCombo" prefWidth="150.0" promptText="Default">
                     <VBox.margin>
                        <Insets left="10.0" />
                     </VBox.margin></ComboBox>
               </children>
            </VBox>
            <CheckBox fx:id="hideArchivedCheckBox" alignment="BOTTOM_CENTER" mnemonicParsing="false" prefHeight="44.0" prefWidth="115.0" text="Hide archived" />
            <Button fx:id="refreshButton" mnemonicParsing="false" onAction="#onClickRefresh" prefHeight="26.0" prefWidth="26.0" />
            <Region prefHeight="44.0" prefWidth="100.0" HBox.hgrow="ALWAYS" />
            <Button fx:id="createButton" alignment="BOTTOM_CENTER" mnemonicParsing="false" onAction="#onClickCreate" text="Create">
               <HBox.margin>
                  <Insets right="10.0" />
               </HBox.margin></Button>
         </children>
         <VBox.margin>
            <Insets />
         </VBox.margin>
      </HBox>
      <TableView fx:id="anomalyTable" VBox.vgrow="ALWAYS">
        <columns>
          <TableColumn fx:id="idColumn" editable="false" prefWidth="106.0" sortable="false" text="ID" />
          <TableColumn fx:id="sectorColumn" editable="false" prefWidth="98.0" sortable="false" text="SECTOR" />
            <TableColumn fx:id="stateColumn" editable="false" prefWidth="123.0" sortable="false" text="STATE" />
            <TableColumn fx:id="descriptionColumn" editable="false" prefWidth="335.0" sortable="false" text="DESCRIPTION" />
            <TableColumn fx:id="createdAtColumn" editable="false" minWidth="0.0" prefWidth="128.0" sortType="DESCENDING" sortable="false" text="CREATED at" />
            <TableColumn fx:id="createdByColumn" editable="false" prefWidth="162.0" sortable="false" text="CREATED by" />
        </columns>
         <VBox.margin>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </VBox.margin>
      </TableView>
      <HBox alignment="CENTER_RIGHT" prefHeight="32.0" prefWidth="953.0">
         <children>
            <Button fx:id="detailsButton" mnemonicParsing="false" onAction="#onClickDetails" prefHeight="37.0" prefWidth="94.0" text="View details">
               <HBox.margin>
                  <Insets bottom="10.0" left="10.0" right="10.0" />
               </HBox.margin></Button>
         </children>
      </HBox>
   </children>
</VBox>
