            <Button fx:id="submitButton" mnemonicParsing="false" onAction="#onClickSubmit" text="Submit" />
            <Button fx:id="cancelButton" mnemonicParsing="false" onAction="#onClickCancel" text="Cancel" />
         </children>
      </HBox>
   </children>
   <padding>
