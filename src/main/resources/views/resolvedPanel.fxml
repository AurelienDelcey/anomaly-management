<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0" spacing="5.0" xmlns="http://javafx.com/javafx/21.0.2" xmlns:fx="http://javafx.com/fxml/1" fx:controller="userInterface.detail.dynamicPanel.ResolvedPanelController">
   <children>
      <HBox prefHeight="100.0" prefWidth="200.0">
         <children>
            <VBox>
               <children>
                  <Label text="Sector:" />
                  <Label fx:id="sectorLabel" text="Label" />
               </children>
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
            <VBox>
               <children>
                  <Label text="Production order:" />
                  <Label fx:id="productionOrderLabel" text="Label" />
               </children>
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
            <VBox>
               <children>
                  <Label text="Machine:" />
                  <Label fx:id="machineLabel" text="Label" />
               </children>
            </VBox>
         </children>
      </HBox>
      <HBox prefHeight="100.0" prefWidth="200.0" spacing="5.0">
         <children>
            <VBox>
               <children>
                  <Label text="Impacted quantity:" />
                  <Label fx:id="impactedQuantityLabel" text="Label" />
               </children>
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
            <VBox>
               <children>
                  <Label text="Corrective action id:" />
                  <Label fx:id="correctiveActionLabel" text="Label" />
               </children>
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
            <VBox>
               <children>
                  <Label text="Quality decision:" />
                  <Label fx:id="qualityDecisionLabel" text="Label" />
               </children>
            </VBox>
         </children>
      </HBox>
      <HBox prefHeight="100.0" prefWidth="200.0" spacing="5.0">
         <children>
            <VBox>
               <children>
                  <Label text="Evidence id:" />
                  <Label fx:id="evidenceLabel" text="Label" />
               </children>
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
            <Label text="Conclusion:" />
            <VBox spacing="10.0">
               <children>
                  <RadioButton fx:id="validButton" mnemonicParsing="false" text="Valid">
                     <toggleGroup>
                        <ToggleGroup fx:id="validationGroup" />
                     </toggleGroup>
                  </RadioButton>
                  <RadioButton fx:id="invalidButton" mnemonicParsing="false" text="Invalid" toggleGroup="$validationGroup" />
               </children>
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
         </children>
      </HBox>
      <Label text="Descrition:" />
      <TextArea fx:id="descriptionTextArea" editable="false" prefHeight="200.0" prefWidth="200.0" />
      <HBox>
         <children>
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="archiveAnomalyButton" mnemonicParsing="false" onAction="#onClickArchiveAnomaly" text="Archive anomaly" />
            <Region HBox.hgrow="ALWAYS" />
         </children>
      </HBox>
   </children>
   <padding>
      <Insets bottom="5.0" left="30.0" right="30.0" top="5.0" />
   </padding>
</VBox>
